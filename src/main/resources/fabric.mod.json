{
  "schemaVersion": 1,
  "id": "beamphysics",
  "version": "${version}",
  "name": "BeamPhysics",
  "description": "Drivable cars with real physics: four independently simulated wheels on raycast suspension, engine and gearbox, crumpling bodywork and parts that tear off.",
  "authors": ["BeamPhysics contributors"],
  "license": "MIT",
  "icon": "assets/beamphysics/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["dev.beamphysics.BeamPhysics"],
    "client": ["dev.beamphysics.client.BeamPhysicsClient"]
  },
  "mixins": [
    {
      "config": "beamphysics.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.15.0",
    "minecraft": "1.20.1",
    "java": ">=17",
    "fabric-api": "*"
  }
}
